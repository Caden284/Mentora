# Mentora environment variables
# Copy this file to .env and fill in values from your Appwrite Cloud console.
# Anything prefixed EXPO_PUBLIC_ is embedded in the app bundle (safe: these are public client IDs).

EXPO_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here
EXPO_PUBLIC_APPWRITE_PLATFORM=com.mentora.app

EXPO_PUBLIC_APPWRITE_DATABASE_ID=mentora
EXPO_PUBLIC_APPWRITE_USERS_COLLECTION_ID=users
EXPO_PUBLIC_APPWRITE_QUESTIONS_COLLECTION_ID=questions
EXPO_PUBLIC_APPWRITE_ANSWERS_COLLECTION_ID=answers
EXPO_PUBLIC_APPWRITE_MEDIA_BUCKET_ID=media
